<% layout("/layouts/boilerplate") -%>
<div class="row">
    <div class="col-8">
        <br><br>
        <h3>Create a New Listing</h3>
        <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
            <br>
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input name="listing[title]" placeholder="Add a Catchy Title" type="text" class="form-control" required/>
                <div class="valid-feedback">Tittle looks good!</div>
            </div>
            <div class="mb-3">
                <lable for="description" class="form-label">Description</label>
                <textarea name="listing[description]" class="form-control" required></textarea>
                
            </div>
            <div class="mb-3">
                <lable for="image" class="form-label">Upload Image</label>
                <input name="listing[image]" type="file" class="form-control" required/>
            </div>
            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Price</label>
                    <input name="listing[price]" placeholder="Enter price" type="number" class="form-control" required/>
                    <div class="invalid-feedback">Please enter valid Price</div>
                </div>
                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country</label>
                    <input name="listing[country]" placeholder="Enter country" type="text" class="form-control" required/>
                    
                    <div class="invalid-feedback">Invalid Country</div>
                </div>
            </div>
            
            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input name="listing[location]" placeholder="enter location" type="text" class="form-control"required />
            </div>
            <br>
            <div class="mb-3">
                <label for="category form-label">Categories</label>
                <select name="listing[category]" id="category" class="category">
                    <option value="Trending">Trending</option>
                    <option value="Rooms">Rooms</option>
                    <option value="Iconic Cities">Iconic Cities</option>
                    <option value="Mountains">Mountains</option>
                    <option value="Castles">Castles</option>
                    <option value="Amazing Pools">Amazing Pools</option>
                    <option value="Camping">Camping</option>
                    <option value="Farms">Farms</option>
                    <option value="Arctic">Arctic</option>
                </select>
                <div class="form-text">Select maximum 3 categories..</div>
            </div>
            <br><br>
            <button class="btn btn-dark add-btn">Add</button><br>
        </form>
    </div>
</div>
